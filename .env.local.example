# ─────────────────────────────────────────────────────────────
# Master Tax Houston — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# GoHighLevel CRM — paste the webhook URL from your GHL account
# Settings → Integrations → Webhooks → New Webhook
GHL_WEBHOOK_URL=

# ── Stripe (only needed if enabling online payments) ─────────
# Keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Price IDs from https://dashboard.stripe.com/products
NEXT_PUBLIC_STRIPE_PRICE_TAXES_BASICO=price_...
NEXT_PUBLIC_STRIPE_PRICE_CREDITO=price_...
NEXT_PUBLIC_STRIPE_PRICE_MENTORIA=price_...
